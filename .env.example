# NODE_ENV remains unset locally; Dokploy sets NODE_ENV=production.
PORT=3001
DATABASE_URL=mysql://birostweb:change-this-password@localhost:53306/birostweb
MYSQL_PASSWORD=change-this-password
APP_ORIGIN=http://127.0.0.1:5184
ADMIN_EMAIL=admin@birostweb.local
# Minimum 14 characters. Set before running db:seed. Never commit .env.
ADMIN_PASSWORD=
SEED_DEMO=false
STORAGE_PATH=./storage
# TRUST_PROXY : IP/CIDR exacts du reverse proxy Dokploy/Traefik (ex. 10.0.1.0/24), ou nombre de sauts.
# 'true' fait confiance à toute adresse (déconseillé : contournement du rate-limit par X-Forwarded-For).
TRUST_PROXY=false
INITIALIZE_ADMIN=false
MYSQL_ROOT_PASSWORD=change-root-password
# --- Facturation Abby (secrets côté serveur uniquement, jamais exposés au front) ---
# Clé API Abby (format suk-...). Ne jamais committer ni logguer.
ABBY_API_KEY=
# Host de l'API (celui qui répond). Défaut : https://api.app-abby.com
ABBY_API_BASE=
# Activation de l'intégration ('false' pour la désactiver). Défaut : activée si ABBY_API_KEY présent.
ABBY_ENABLED=
# Filet de sécurité : mettre 'true' UNIQUEMENT pour autoriser la finalisation de factures
# légales RÉELLES (numéro officiel irréversible). Laisser vide bloque la finalisation hors mode test.
ABBY_ALLOW_LIVE_FINALIZE=
# --- Double authentification (obligatoire pour les administrateurs) ---
# Clé de chiffrement AES-256-GCM des secrets TOTP : 32 octets en base64 ou 64 caractères hex
# (ex. `openssl rand -hex 32`). OBLIGATOIRE en production. À stocker uniquement dans Dokploy,
# distincte des sauvegardes de base ; sa perte rend les 2FA existantes inutilisables (codes de secours).
TOTP_ENCRYPTION_KEY=
# --- Webhook Cal.com ---
# Secret HMAC partagé avec Cal.com (header x-cal-signature-256). Vide = webhook refusé.
CALCOM_WEBHOOK_SECRET=
# Fenêtre de fraîcheur anti-rejeu (secondes) sur le champ createdAt signé. Défaut : 600.
CALCOM_WEBHOOK_TOLERANCE_SECONDS=
# --- Divers ---
# Base de l'API Pwned Passwords (défaut : https://api.pwnedpasswords.com/range/).
HIBP_URL=
# Tests uniquement : base jetable dédiée (nom obligatoire birostweb_test) et mock Abby sans réseau.
TEST_DATABASE_URL=
ABBY_MOCK=

# Clé AES-256 IBAN, 32 octets base64 ou 64 caractères hex, à sauvegarder séparément du dump SQL.
IBAN_ENCRYPTION_KEY=
