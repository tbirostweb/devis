# NODE_ENV remains unset locally; Dokploy sets NODE_ENV=production.
PORT=3001
DATABASE_URL=mysql://birostweb:change-this-password@localhost:53306/birostweb
MYSQL_PASSWORD=change-this-password
APP_ORIGIN=http://127.0.0.1:5184
ADMIN_EMAIL=admin@birostweb.local
# Minimum 14 characters. Set before running db:seed. Never commit .env.
ADMIN_PASSWORD=
SEED_DEMO=false
STORAGE_PATH=./storage
TRUST_PROXY=false
INITIALIZE_ADMIN=false
MYSQL_ROOT_PASSWORD=change-root-password
# --- Facturation Abby (secrets côté serveur uniquement, jamais exposés au front) ---
# Clé API Abby (format suk-...). Ne jamais committer ni logguer.
ABBY_API_KEY=
# Host de l'API (celui qui répond). Défaut : https://api.app-abby.com
ABBY_API_BASE=
# Activation de l'intégration ('false' pour la désactiver). Défaut : activée si ABBY_API_KEY présent.
ABBY_ENABLED=
# Filet de sécurité : mettre 'true' UNIQUEMENT pour autoriser la finalisation de factures
# légales RÉELLES (numéro officiel irréversible). Laisser vide bloque la finalisation hors mode test.
ABBY_ALLOW_LIVE_FINALIZE=
